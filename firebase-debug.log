[debug] [2026-07-31T14:09:55.507Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/internai-a8bb6/rulesets {"name":"projects/internai-a8bb6/rulesets/f72c3b1f-0edd-4b46-85de-be08b0c0d9fe","source":{"files":[{"content":"rules_version = '2';\n\n// InternAI — hardened Security Rules (prototype: review before broad release)\n//\n// Assumed roles on users/{uid}: admin | club_manager | student\n// Legacy role strings (kulüp_yöneticisi, manager) treated as club_manager in helpers.\n//\n// Doc ID patterns:\n//   checkins/{eventId}_{uid}\n//   rsvps/{eventId}_{uid}\n//   club_members/{clubId}_{uid}\n//   club_applications/{clubId}_{uid}\n//   clubs/{clubId}  (handle)\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // ===============================================================\n    // Helpers\n    // ===============================================================\n\n    function isAuth() {\n      return request.auth != null;\n    }\n\n    function isSelf(uid) {\n      return isAuth() && request.auth.uid == uid;\n    }\n\n    function userDocPath() {\n      return /databases/$(database)/documents/users/$(request.auth.uid);\n    }\n\n    function userDocExists() {\n      return isAuth() && exists(userDocPath());\n    }\n\n    function userData() {\n      return get(userDocPath()).data;\n    }\n\n    function userRole() {\n      return userDocExists() ? userData().role : '';\n    }\n\n    function isAdmin() {\n      return userDocExists() && userRole() == 'admin';\n    }\n\n    function isClubManager() {\n      return userDocExists() && userRole() in ['club_manager', 'kulüp_yöneticisi', 'manager'];\n    }\n\n    function managerClubId() {\n      return userDocExists() && 'clubId' in userData() ? userData().clubId : '';\n    }\n\n    function canManageClub(clubId) {\n      return isAdmin() || (isClubManager() && managerClubId() == clubId);\n    }\n\n    function isLegacyCollection(collectionId) {\n      return collectionId in [\n        'Check-in',\n        'RSVP\\'ler',\n        'Kullanıcılar',\n        'Kulüpler',\n        'KulüpÜyeleri',\n        'KulüpBaşvuruları',\n        'KulüpPaylasimlari',\n        'Etkinlikler'\n      ];\n    }\n\n    function selfUserUpdateAllowed() {\n      return request.resource.data.diff(resource.data).affectedKeys()\n        .hasOnly(['Rozetler', 'pointsTotal', 'lastBadgeWrite', 'badges']);\n    }\n\n    function privilegedUserFieldsUnchanged() {\n      return request.resource.data.get('role', resource.data.get('role', 'student'))\n          == resource.data.get('role', 'student')\n        && request.resource.data.get('clubId', resource.data.get('clubId', ''))\n          == resource.data.get('clubId', '')\n        && request.resource.data.get('banned', resource.data.get('banned', false))\n          == resource.data.get('banned', false);\n    }\n\n    function isValidNotificationSettings() {\n      return request.resource.data.keys().hasOnly([\n          'newInternships',\n          'applicationReminders',\n          'aiCareerSuggestions'\n        ])\n        && request.resource.data.newInternships is bool\n        && request.resource.data.applicationReminders is bool\n        && request.resource.data.aiCareerSuggestions is bool;\n    }\n\n    // ===============================================================\n    // users\n    // ===============================================================\n\n    match /users/{uid} {\n      allow read: if isAuth() && (isSelf(uid) || isAdmin());\n\n      allow create: if isSelf(uid)\n        && request.resource.data.role == 'student'\n        && request.resource.data.banned == false\n        && request.resource.data.email is string;\n\n      allow update: if isAdmin()\n        || (isSelf(uid) && selfUserUpdateAllowed() && privilegedUserFieldsUnchanged());\n\n      allow delete: if isAdmin();\n\n      // users/{uid}/settings/notifications — bildirim tercihleri (MVP)\n      match /settings/{settingId} {\n        allow read: if isAuth() && (isSelf(uid) || isAdmin());\n\n        allow create, update: if isSelf(uid)\n          && settingId == 'notifications'\n          && isValidNotificationSettings();\n\n        allow delete: if isAdmin();\n      }\n    }\n\n    // ===============================================================\n    // checkins\n    // ===============================================================\n\n    match /checkins/{docId} {\n      allow read: if isAuth()\n        && (\n          !exists(/databases/$(database)/documents/checkins/$(docId))\n          || resource.data.uid == request.auth.uid\n          || isAdmin()\n          || isClubManager()\n        );\n\n      allow create: if isAuth()\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.eventId is string\n        && docId == request.resource.data.eventId + '_' + request.auth.uid\n        && !exists(/databases/$(database)/documents/checkins/$(docId));\n\n      allow update, delete: if isAdmin();\n    }\n\n    // ===============================================================\n    // rsvps\n    // ===============================================================\n\n    match /rsvps/{docId} {\n      allow read: if isAuth()\n        && (\n          !exists(/databases/$(database)/documents/rsvps/$(docId))\n          || resource.data.uid == request.auth.uid\n          || isAdmin()\n          || isClubManager()\n        );\n\n      allow create, update: if isAuth()\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.eventId is string\n        && docId == request.resource.data.eventId + '_' + request.auth.uid;\n\n      allow delete: if isAuth()\n        && (resource.data.uid == request.auth.uid || isAdmin());\n    }\n\n    // ===============================================================\n    // events\n    // ===============================================================\n\n    match /events/{eventId} {\n      allow read: if isAuth();\n\n      allow create: if isAuth() && (\n        isAdmin()\n        || (isClubManager() && request.resource.data.clubId == managerClubId())\n      );\n\n      allow update, delete: if isAuth() && (\n        isAdmin()\n        || (isClubManager() && resource.data.clubId == managerClubId())\n      );\n    }\n\n    // ===============================================================\n    // clubs\n    // ===============================================================\n\n    match /clubs/{clubId} {\n      allow read: if isAuth();\n\n      allow create: if isAuth()\n        && request.resource.data.status == 'pending'\n        && request.resource.data.name is string\n        && request.auth.uid in request.resource.data.managerUids;\n\n      allow update, delete: if canManageClub(clubId);\n    }\n\n    // ===============================================================\n    // club_posts\n    // ===============================================================\n\n    match /club_posts/{postId} {\n      allow read: if isAuth();\n\n      allow create: if isAuth()\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.clubId is string\n        && canManageClub(request.resource.data.clubId);\n\n      allow update, delete: if isAuth() && (\n        isAdmin()\n        || (resource.data.uid == request.auth.uid && canManageClub(resource.data.clubId))\n        || canManageClub(resource.data.clubId)\n      );\n    }\n\n    // ===============================================================\n    // club_members\n    // ===============================================================\n\n    match /club_members/{docId} {\n      allow read: if isAuth();\n\n      allow create: if isAuth()\n        && request.resource.data.uid is string\n        && request.resource.data.clubId is string\n        && docId == request.resource.data.clubId + '_' + request.resource.data.uid\n        && canManageClub(request.resource.data.clubId);\n\n      allow update, delete: if isAuth()\n        && resource.data.clubId is string\n        && canManageClub(resource.data.clubId);\n    }\n\n    // ===============================================================\n    // club_applications\n    // ===============================================================\n\n    match /club_applications/{docId} {\n      allow read: if isAuth() && (\n        !exists(/databases/$(database)/documents/club_applications/$(docId))\n        || resource.data.uid == request.auth.uid\n        || canManageClub(resource.data.clubId)\n        || isAdmin()\n      );\n\n      allow create: if isAuth()\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.clubId is string\n        && request.resource.data.status == 'pending'\n        && docId == request.resource.data.clubId + '_' + request.auth.uid;\n\n      allow update: if isAuth() && (\n        canManageClub(resource.data.clubId)\n        || isAdmin()\n      );\n\n      allow delete: if isAdmin();\n    }\n\n    // ===============================================================\n    // sessions (QR check-in)\n    // ===============================================================\n\n    match /sessions/{sessionId} {\n      allow read: if isAuth();\n\n      allow create: if isAuth()\n        && request.resource.data.clubId is string\n        && request.resource.data.eventId is string\n        && request.resource.data.active == true\n        && canManageClub(request.resource.data.clubId);\n\n      allow update: if isAuth()\n        && resource.data.clubId is string\n        && canManageClub(resource.data.clubId);\n\n      allow delete: if isAdmin();\n    }\n\n    // ===============================================================\n    // Legacy collections — read-only (migration)\n    // ===============================================================\n\n    match /{collectionId}/{docId} {\n      allow read: if isAuth() && isLegacyCollection(collectionId);\n      allow write: if false;\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-07-31T14:09:55.334207Z","metadata":{"services":["cloud.firestore"]}}
